# Sites gateway (ADR 0009). https://<sites-host>/<slug>/<file>  ->  API /sites/<slug>/<file>
# One gateway for every published site (no container per site). Only GET/HEAD on slug paths reach the API, plus the POST of website forms
# (small body, rate limited); everything else is 404.
# The API sends "public, no-cache" for pages (revalidate: visibility changes, rollbacks and unpublishing apply immediately),
# "public, max-age=31536000, immutable" for assets/ (content never changes for an asset id) and "private, no-store" for private sites.
upstream studio_api { server ${API_UPSTREAM}; keepalive 16; }
proxy_cache_path /tmp/sites-cache levels=1:2 keys_zone=sites:10m max_size=512m inactive=30m use_temp_path=off;
limit_req_zone $binary_remote_addr zone=sites_rl:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=forms_rl:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=data_rl:10m rate=10r/s;
map $http_x_forwarded_proto $fwd_proto { default $http_x_forwarded_proto; "" $scheme; }
# X-Forwarded-For is passed through unchanged: the gateway is published on 127.0.0.1 only and sits behind the tunnel (cloudflared), which
# sets the visitor address; appending this hop (the Docker bridge) would make every visitor look the same to the API's rate limits.

# --- the company sites host: /<slug>/...
server {
    listen 8080;
    server_name ${SITES_HOST} localhost 127.0.0.1;
    # Client address (D-C0-37): X-Forwarded-For is believed ONLY from the proxies named in GATEWAY_REAL_IP_FROM (default 127.0.0.1 = none: the gateway is reached
    # directly). Behind a tunnel / load balancer name its address range; then $remote_addr below is the visitor, for limit_req and for the API.
    set_real_ip_from ${GATEWAY_REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    server_tokens off;
    client_max_body_size 1k;

    # browsers ask every host for /favicon.ico; sites have none at the root
    location = /favicon.ico { access_log off; log_not_found off; return 204; }
    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    # website forms: a plain HTML POST (urlencoded, at most 16 KiB), a few per minute per visitor
    location ~ "^/[a-z0-9][a-z0-9-]{1,79}/_forms/[a-z0-9][a-z0-9-]{0,63}$" {
        limit_except POST { deny all; }
        limit_req zone=forms_rl burst=5 nodelay;
        client_max_body_size 16k;
        rewrite ^/(.*)$ /sites/$1 break;
        proxy_pass http://studio_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # Public Data Runtime (docs/contracts/v2/published-runtime.md section 4, D-C0-35): the page's runtime asks ITS OWN origin, never another host.
    #   POST /<slug>/_data/queries/<queryId>/run  ->  API POST /sites/<slug>/_data/queries/<queryId>/run
    # POST only, a small body (the request is {"params":{...}} of one query), rate limited per visitor address. This is anonymous by design: no cookie and
    # no Authorization header ever reaches the API on this route (the visitor has no session to ride and a stray credential must not be honoured).
    # Only this exact path shape is routed; anything else under /<slug>/_data/ falls to the generic block below (GET / HEAD only) and is refused.
    location ~ "^/[a-z0-9][a-z0-9-]{1,79}/_data/queries/[a-z0-9][a-z0-9-]{0,63}/run$" {
        limit_except POST { deny all; }
        limit_req zone=data_rl burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
        # the runtime never sends a query string, so none is passed on (the trailing "?" drops it): no unvalidated input reaches the API on this route
        rewrite ^/(.*)$ /sites/$1? break;
        proxy_pass http://studio_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # one validated address, never the header the visitor sent (a spoofed X-Forwarded-For cannot choose its own rate-limit bucket)
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-XSRF-TOKEN "";
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # server app APIs (stage J): every method, small bodies; the API checks the app's declared routes and passes them to the isolated runtime
    location ~ "^/(_app/[A-Za-z0-9_-]{20,100}|[a-z0-9][a-z0-9-]{1,79})/api(/.*)?$" {
        limit_req zone=sites_rl burst=60 nodelay;
        client_max_body_size 1m;
        rewrite ^/(.*)$ /sites/$1 break;
        proxy_pass http://studio_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location ~ "^/(_access|_preview|_app|[a-z0-9][a-z0-9-]{1,79})(/.*)?$" {
        limit_except GET HEAD { deny all; }
        limit_req zone=sites_rl burst=60 nodelay;
        rewrite ^/(.*)$ /sites/$1 break;
        proxy_pass http://studio_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_cache sites;
        proxy_cache_key $host$request_uri;
        proxy_cache_bypass $cookie_site_session;
        proxy_no_cache $cookie_site_session;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache $upstream_cache_status always;
    }

    location / { default_type text/plain; return 404 "not found\n"; }
}

# --- verified custom domains (any other Host): the whole path belongs to one public website; the API decides from Host
server {
    listen 8080 default_server;
    server_name _;
    # Client address (D-C0-37): X-Forwarded-For is believed ONLY from the proxies named in GATEWAY_REAL_IP_FROM (default 127.0.0.1 = none: the gateway is reached
    # directly). Behind a tunnel / load balancer name its address range; then $remote_addr below is the visitor, for limit_req and for the API.
    set_real_ip_from ${GATEWAY_REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    server_tokens off;
    client_max_body_size 1k;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    location ~ "^/_forms/[a-z0-9][a-z0-9-]{0,63}$" {
        limit_except POST { deny all; }
        limit_req zone=forms_rl burst=5 nodelay;
        client_max_body_size 16k;
        rewrite ^/(.*)$ /sites/_host/$1 break;
        proxy_pass http://studio_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location / {
        limit_except GET HEAD { deny all; }
        limit_req zone=sites_rl burst=60 nodelay;
        rewrite ^/(.*)$ /sites/_host/$1 break;
        proxy_pass http://studio_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_cache sites;
        proxy_cache_key $host$request_uri;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache $upstream_cache_status always;
    }
}
