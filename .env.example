# ---------------------------------------------------------------------------
# Frontend
#   mock = static demo, no backend (this is what GitHub Pages uses)
#   http = real backend through a same-origin /api proxy
# NEXT_PUBLIC_* values are baked in at build/dev-server start.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_MODE=mock
# Where the Next.js dev server proxies /api/* in http mode.
API_PROXY_TARGET=http://127.0.0.1:8080
# Dev UI port (3000 is often taken by other tools on this machine).
FRONTEND_PORT=3100

# ---------------------------------------------------------------------------
# Backend (profile "local" enables the dev seed user and Swagger UI)
# ---------------------------------------------------------------------------
APP_PROFILE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
COOKIE_SECURE=false
SESSION_COOKIE_NAME=STUDIO_SESSION
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# V2 frontend portals (docs/adr/0022): three exact origins, no wildcard. Not read for CORS until the C5 import (docs/parallel/WEB_SECURITY_CONFIG.md §3).
# WEB_ORIGIN_PLATFORM=http://localhost:3001
# WEB_ORIGIN_ADMIN=http://localhost:3002
# WEB_ORIGIN_STUDIO=http://localhost:3003
# V2 feature switches are OFF by default and must stay unset (docs/parallel/WEB_SECURITY_CONFIG.md §1).

# Dev admin created by the local profile. Pick a unique value of at least 14 characters.
LOCAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Infrastructure (docker compose up -d). Host ports are deliberately non-default
# so they never collide with another Postgres/Redis already on this machine.
# ---------------------------------------------------------------------------
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
RABBITMQ_AMQP_PORT=15674
RABBITMQ_MGMT_PORT=15675

DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/system_web_studio
DATABASE_USER=studio
DATABASE_PASSWORD=studio-local-only
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_BUCKET=studio-assets
MINIO_ROOT_USER=studio-minio
MINIO_ROOT_PASSWORD=studio-local-only
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15674
RABBITMQ_USER=studio
RABBITMQ_PASSWORD=studio-local-only
