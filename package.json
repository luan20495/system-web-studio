{
  "name": "system-web-studio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "dev:platform": "npm run dev -w @xweb/app-platform",
    "dev:admin": "npm run dev -w @xweb/app-admin",
    "dev:studio": "npm run dev -w @xweb/app-studio",
    "build:platform": "npm run build -w @xweb/app-platform",
    "build:admin": "npm run build -w @xweb/app-admin",
    "build:studio": "npm run build -w @xweb/app-studio",
    "build:apps": "npm run build:platform && npm run build:admin && npm run build:studio",
    "typecheck:apps": "npm run typecheck -w @xweb/app-platform -w @xweb/app-admin -w @xweb/app-studio",
    "typecheck:packages": "npm run typecheck --workspaces --if-present --include-workspace-root=false",
    "typecheck:all": "npm run typecheck:packages",
    "test:unit": "node scripts/test-unit.mjs",
    "test:classify": "node scripts/test-classify.mjs",
    "test:e2e:real": "node tests/e2e-real/run.mjs",
    "test:e2e:real:selftest": "node tests/e2e-real/selftest.mjs",
    "test:browser:build": "node tests/browser/build-harness.mjs",
    "guard:static": "node tests/guards/run-static.mjs",
    "guard:test": "node --test tests/guards/guards.test.mjs",
    "scan:bundles": "node scripts/scan-prod-bundles.mjs",
    "gate:frontend": "node scripts/gate-frontend.mjs",
    "test:infra:portals": "node --test tests/infra/portals-reliability.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.0"
  },
  "workspaces": [
    "apps/platform",
    "apps/admin",
    "apps/studio",
    "packages/api-client",
    "packages/auth",
    "packages/i18n",
    "packages/permissions",
    "packages/types",
    "packages/ui"
  ]
}
