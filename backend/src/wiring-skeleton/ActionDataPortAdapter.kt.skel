package com.systemwebstudio.wiring

import com.systemwebstudio.app.definition.AppDataBindingResolver     // C2 (fix/c2-v2 99d8169): pure, reads an AppDefinitionV2
import com.systemwebstudio.app.definition.AppDefinitionCodec          // C2 codec: JsonNode -> AppDefinitionV2
import com.systemwebstudio.app.definition.AppResolutionException
import com.systemwebstudio.data.datasource.ConnectorFailure           // C3
import com.systemwebstudio.data.datasource.FailureCodes
import com.systemwebstudio.data.gateway.DataGateway                   // C3
import com.systemwebstudio.data.gateway.GatewayMutation
import com.systemwebstudio.logic.action.ActionContext                 // C4
import com.systemwebstudio.logic.action.ActionDataPort
import com.systemwebstudio.logic.action.OperationRequest
import com.systemwebstudio.logic.action.PortOutcome
import com.systemwebstudio.logic.action.WriteRequest
import com.systemwebstudio.logic.action.canonical.AppDefinitionSource

/*
 * THE data path (docs/contracts/v2/action-workflow.md §4):  Action -> ActionDataPort -> [this adapter + AppDataBindingResolver] -> DataGateway -> DataSource -> Connector.
 *
 * write(ctx, WriteRequest(appId, mode, queryRef, kind, params, idempotencyKey)):
 *   1. gctx  = RequestContexts-style GatewayContext from ctx (tenant, actor USER, workspace, project = appId, appVersionId of the LIVE version / null for TEST)
 *   2. doc   = AppDefinitionSource.load(ctx.tenantId, request.appId, request.mode)  ?: Failure(APP_NOT_FOUND, retryable=false)
 *   3. res   = AppDataBindingResolver(AppDefinitionCodec.read(doc), slotBindings = ...).query(request.queryRef)      // local ids -> (DataSource UUID, operationKey)
 *              res.mode must be WRITE, else Failure(WRONG_MODE); AppResolutionException(code) -> Failure(code, retryable = false)
 *   4. call  = DataGateway.mutate(gctx, GatewayMutation(res.dataSource.sourceId, res.operationKey, request.params, request.idempotencyKey))
 *              — the key is the DERIVED key from C4 and is forwarded UNCHANGED. The adapter never builds, shortens or logs a key.
 *   5. map   = see the table below.
 * callOperation(...) (CALL_API) is the same with `resolver.dataSource(request.dataSourceRef)` + `request.operationKey`; no URL, header or credential exists in the request.
 * dryRunWrite / dryRunOperation: NOT overridden -> DryRunOutcome.Unsupported (C4 reports NOT_EXECUTED). Never emulate a dry run here.
 *
 * ConnectorFailure.code -> PortOutcome.Failure(code, retryable)   (docs/contracts/v2/data-runtime.md §4b)
 *   IDEMPOTENCY_OUTCOME_UNKNOWN (409) .... retryable = false   (do not retry, do not compensate as "not applied")
 *   MUTATION_REJECTED (422) .............. retryable = false   (nothing applied)
 *   IDEMPOTENCY_IN_PROGRESS (409), RATE_LIMITED (429) ... retryable = true  (backoff)
 *   IDEMPOTENCY_CONFLICT, PERMISSION_DENIED, INVALID_PARAMS, *_NOT_FOUND, TENANT_MISMATCH, MUTATION_UNSUPPORTED, READ_ONLY_VIOLATION ... retryable = false
 *   TIMEOUT, CONNECT_FAILED, UPSTREAM_STATUS, QUERY_FAILED, RESPONSE_*, INTERNAL, anything unclassified ... a WRITE that ended this way is reported as
 *        Failure("IDEMPOTENCY_OUTCOME_UNKNOWN", retryable = false), because C3 has already moved the key to UNKNOWN and the next attempt would answer 409.
 *   message = a fixed text per code; never the exception message, never params.
 */
class ActionDataPortAdapter(
    private val definitions: AppDefinitionSource,
    private val gateway: DataGateway
    /* , private val contexts: RequestContexts — for the GatewayContext of a worker (stored run creator) */
) : ActionDataPort {

