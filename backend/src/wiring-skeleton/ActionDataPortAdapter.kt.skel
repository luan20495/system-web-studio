        TODO("W-05: steps 1-5 above for WriteRequest")

    override fun callOperation(ctx: ActionContext, request: OperationRequest): PortOutcome =
        TODO("W-05: steps 1-5 above for OperationRequest (resolver.dataSource(request.dataSourceRef) + request.operationKey)")
}
