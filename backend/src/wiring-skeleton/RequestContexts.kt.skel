/*
 * HTTP / session -> Principal -> TenantContext -> C1 adapters
 *
 *   1. Spring Security session (cookie, CSRF checked) ................ StudioUserDetails(userId)               [base]
 *   2. Principal(kind = ActorKind.USER, userId = me.userId) ......... the ONLY actor kind a request can have today (ActorPolicy: SYSTEM/SERVICE/APP_TOKEN are denied)
 *   3. AccessService.forProject(userId, workspaceId, projectId)
 *        -> AccessContext(tenantId, tenantContext = TenantContext(tenantId, tenantRole, status, platformScope), permissions)
 *      The workspace id comes from the PATH of the request; the tenant is re-derived from the workspace row by TenantResolver.
 *      A tenant id, organization id or role in a body / query / header is never read.  Unknown workspace or no membership = 404; SUSPENDED tenant = 403 TENANT_SUSPENDED.
 *   4. GatewayContext(tenant = access.tenantContext, actorUserId, actorKind, requestId, workspaceId, projectId, appVersionId)   [C3 shape, built here]
 *      ActionContext(tenantId = access.tenantId, actor = ActionActor(userId, kind), workspaceId, projectId, requestId)           [C4 shape, built here]
 *   5. Workers (queue / scheduler / sync) rebuild the SAME contexts from the stored run creator or job owner (tenantId + userId), never from a payload.
 */
class RequestContexts(private val access: AccessService /* , private val requestIds: RequestIdProvider (base X-Request-Id filter) */) {

