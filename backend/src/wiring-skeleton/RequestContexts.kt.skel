            "return GatewayContext(a.tenantContext, me.userId, ActorKind.USER, requestId, workspaceId, projectId, appVersionId)")

    /** TODO(W-01): same resolution; ActionContext.tenantId = a.tenantId. The app's own tenant is verified again by AppDefinitionSourceAdapter. */
    fun actionContext(me: StudioUserDetails, workspaceId: UUID, projectId: UUID, requestId: String?): ActionContext =
        TODO("W-01: val a = access.forProject(me.userId, workspaceId, projectId); return ActionContext(a.tenantId, ActionActor(me.userId, ActorKind.USER), workspaceId, projectId, requestId)")

    /** TODO(W-01): worker side. Re-read the creator's membership NOW (a removed member must not keep running): build via access.forProject(creatorUserId, ...) and fail the run on 403/404. */
    fun actionContextForWorker(tenantId: UUID, creatorUserId: UUID, workspaceId: UUID?, projectId: UUID?, requestId: String?): ActionContext =
        TODO("W-01 (C4 worker): rebuild + re-authorise; a disabled tenant fails the run TENANT_DISABLED (TenantGate)")

    /** the Principal handed to C1's pure policy cores */
