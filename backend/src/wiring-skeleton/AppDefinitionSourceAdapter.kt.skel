package com.systemwebstudio.wiring

import com.systemwebstudio.logic.action.ExecutionMode
import com.systemwebstudio.logic.action.canonical.AppDefinitionSource    // C4 port (agent/c4-workflow 6fff346)
import org.springframework.jdbc.core.JdbcTemplate
import tools.jackson.databind.JsonNode
import java.util.UUID

/*
 * C4 `AppDefinitionSource.load(tenantId, appId, mode): JsonNode?`  <-  the committed AppDefinition JSON (C2 shape, read through the base schema/version modules).
 *
 *   mode LIVE : the version of the app's RUNNING deployment (deployments.status = 'RUNNING', newest; its `version_id` -> project_versions.schema_json). Never `projects.current_*`.
 *               A rollback therefore changes what LIVE actions use, exactly like what the site serves.
 *   mode TEST : the working draft (the current committed revision of the project: SchemaRepository / SchemaService), i.e. what the editor shows.
 *
 * TENANT RULE (the check that makes C4's `def.tenantId == ctx.tenantId` non-tautological): the project's tenant is read from
 * `projects.tenant_id` (V26, equal to its workspace's tenant by composite FK) and compared with `tenantId`; a different tenant answers null — indistinguishable from "no such app".
 * The adapter returns the stored JSON UNCHANGED (no reshaping, no default filling): C4's `CanonicalActionReader` and C2's `AppDataBindingResolver` read the same document.
 */
class AppDefinitionSourceAdapter(private val jdbc: JdbcTemplate /* base */, /* private val schemas: SchemaRepository (base, version/) */) : AppDefinitionSource {
    override fun load(tenantId: UUID, appId: UUID, mode: ExecutionMode): JsonNode? =
        TODO("W-04: 1) SELECT tenant_id FROM projects WHERE id = ? AND active -> must equal tenantId else return null; " +
            "2) LIVE -> latest deployments row of the project with status RUNNING -> its version_id -> that version's schema document; none = null; " +
            "3) TEST -> the current draft document of the project; 4) never throw the tenant of another app into a message")
}
