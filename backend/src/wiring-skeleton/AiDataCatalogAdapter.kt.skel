package com.systemwebstudio.wiring

import com.systemwebstudio.access.AccessContext
import com.systemwebstudio.ai.planner.AiDataCatalog as PlannerCatalog         // C2's consumer port: fun interface granted(ctx: AccessContext): List<GrantedDataSource>
import com.systemwebstudio.ai.planner.GrantedDataSource
import com.systemwebstudio.ai.planner.GrantedOperation
import com.systemwebstudio.data.discovery.AiDataCatalogProvider                // C3 provider: catalog(GatewayContext, AiCatalogOptions) -> AiDataCatalog
import com.systemwebstudio.data.gateway.GatewayContext

/*
 * C3 AiDataCatalogProvider (masked, per-caller, default-deny)  ->  C2 planner's PlannerCatalog.
 *
 *   AiCatalogDataSource(id, name, type, schema?, queries[], mutations[])  ->  GrantedDataSource(sourceRef = id.toString(), type, name, operations)
 *   AiCatalogQuery(id, params[], maxRows)                                 ->  GrantedOperation(key = id, mode = READ,  params = params.map { it.name }, fields = entity fields of the query's entity, names only)
 *   AiCatalogMutation(id, kind, params[], entity?)                        ->  GrantedOperation(key = id, mode = WRITE, params = params.map { it.name }, fields = entity fields, names only)
 *
 * Only NAMES cross: no sample values (includeMaskedSamples stays false), no `sensitive` field (C3 already removed it from names it must not give), no host, URL, port, SQL,
 * credential reference or configNonSecret. `sourceRef` is opaque to the model (C2 never sends it) and is what C2's `dataSources[].sourceRef` stores.
 * The context is the caller's: GatewayContext built from the AccessContext the planner endpoint already resolved (RequestContexts.gatewayContext). No tenant parameter exists.
 */
class AiDataCatalogAdapter(private val provider: AiDataCatalogProvider /* , private val contexts: RequestContexts */) : PlannerCatalog {
