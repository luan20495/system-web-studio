{
  "name": "factory-server-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "build": "vite build && node node_modules/esbuild/bin/esbuild server/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server/server.cjs --external:pg-native --log-level=warning && cp openapi.json dist/server/openapi.json"
  },
  "dependencies": {
    "@company/app-sdk": "1.0.0",
    "@company/ui": "1.0.0",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  },
  "overrides": {
    "rollup": "4.62.0"
  }
}
