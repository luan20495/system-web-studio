index 0000000..60c7dc6
--- /dev/null
+++ b/backend/src/test/kotlin/com/systemwebstudio/logic/workflow/ScheduledRunScopeTests.kt
@@ -0,0 +1,121 @@
+package com.systemwebstudio.logic.workflow
+
+import com.systemwebstudio.logic.action.AccessRequest
+import com.systemwebstudio.logic.action.ActionActor
+import com.systemwebstudio.logic.action.ActionContext
+import com.systemwebstudio.logic.action.ActionPorts
+import com.systemwebstudio.logic.action.ActionRig
+import com.systemwebstudio.logic.action.AuthorizationDecision
+import com.systemwebstudio.logic.action.FakeAccess
+import com.systemwebstudio.logic.action.FakeTenants
+import com.systemwebstudio.logic.action.Fx
+import com.systemwebstudio.logic.action.LogicPermissions
+import com.systemwebstudio.logic.action.PortOutcome
+import com.systemwebstudio.logic.action.RecordingLogicAudit
+import com.systemwebstudio.logic.action.StartWorkflowRequest
+import com.systemwebstudio.logic.action.TestClock
+import com.systemwebstudio.logic.action.WorkflowStarterPort
+import com.systemwebstudio.logic.action.handlers.DefaultActionHandlers
+import com.systemwebstudio.logic.scheduler.EnqueueOutcome
+import com.systemwebstudio.logic.scheduler.ScheduleTarget
+import com.systemwebstudio.logic.scheduler.ScheduledRunRequest
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Test
+import java.util.UUID
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+
+/**
+ * A scheduled fire runs inside the resource scope its schedule carries (tenant, workspace, project) and as its owner, with authorization evaluated live at the fire
+ * and at every effectful step. The access policy is C1-shaped (workspace required, live, per user): the scope is never a wildcard.
+ */
+class ScheduledRunScopeTests {
+    private val executor = Executors.newCachedThreadPool()
+    @AfterEach fun stop() { executor.shutdownNow() }
+    private val w1 = Fx.workspaceA
+    private val w2 = UUID.fromString("00000000-0000-0000-0000-0000000000c2")
+    private val owner = Fx.user
+
+    private class Policy : FakeAccess() {
+        val grants = ConcurrentHashMap<UUID, Triple<UUID, UUID, MutableSet<String>>>()      // user -> (workspace, project, permissions)
+        val disabled: MutableSet<UUID> = ConcurrentHashMap.newKeySet()
+        override fun check(ctx: ActionContext, request: AccessRequest): AuthorizationDecision {
+            val ws = ctx.workspaceId ?: return AuthorizationDecision.Denied("workspace required")        // exactly C1's answer
+            if (ctx.actor.userId in disabled) return AuthorizationDecision.Denied("ACCOUNT_DISABLED")
+            val (gw, gp, perms) = grants[ctx.actor.userId] ?: return AuthorizationDecision.Denied("not a member")
+            if (ws != gw || (request.appId ?: ctx.projectId) != gp) return AuthorizationDecision.Denied("scope mismatch")
+            return if (request.permission in perms) AuthorizationDecision.Allowed else AuthorizationDecision.Denied("missing permission")
+        }
+    }
+
+    private inner class Rig {
+        val policy = Policy()
+        val clock = TestClock()
+        val tenants = FakeTenants()
+        private var engineRef: WorkflowEngine? = null
+        private val starter = object : WorkflowStarterPort { override fun start(ctx: ActionContext, request: StartWorkflowRequest): PortOutcome = engineRef!!.start(ctx, request) }
+        val actionRig = ActionRig.build(Fx.write("w1"), access = policy, tenants = tenants, executor = executor, clock = clock,
+            registry = { d, n, _ -> DefaultActionHandlers.registry(Fx.json, ActionPorts(d, n, starter)) })
+        val queue = InMemoryWorkflowQueue()
+        val runs = InMemoryWorkflowRunStore()
+        val engine = WorkflowEngine(Fx.json, FakeWorkflowDefs(wf("nightly", act("a", "w1"))), actionRig.runtime, runs, queue, policy, tenants, RecordingLogicAudit(), null, WorkflowLimits(), clock)
+            .also { engineRef = it }
+        val worker = WorkflowWorker(engine, queue)
+        fun fire(workspace: UUID? = w1, key: String = "sched:" + UUID.randomUUID()) =
+            ScheduledRunRequest(Fx.tenantA, Fx.appA, UUID.randomUUID(), owner, ScheduleTarget.Workflow("nightly"), null, clock.instant(), key, workspace)
+        fun grant(vararg p: String) = policy.grants.put(owner, Triple(w1, Fx.appA, p.toMutableSet()))
+        val all = arrayOf(LogicPermissions.APP_USE, LogicPermissions.ACTION_EXECUTE, LogicPermissions.WORKFLOW_EXECUTE, LogicPermissions.DATA_MUTATE)
+        fun drain() { while (worker.runOnce()) Unit }
+        fun writes() = actionRig.data.writes.size
+        fun runCount() = runs.list(Fx.tenantA, null, 10).size
+    }
+
+    @Test fun `A a fire in the right scope runs the action step and the run keeps the scope`() {
+        val r = Rig(); r.grant(*r.all)
+        assertThat(r.engine.enqueue(r.fire())).isInstanceOf(EnqueueOutcome.Enqueued::class.java)
+        r.drain()
+        val run = r.runs.list(Fx.tenantA, null, 10).single()
+        assertThat(run.workspaceId).isEqualTo(w1)
+        assertThat(run.status).isEqualTo(WorkflowRunStatus.SUCCEEDED)
+        assertThat(r.writes()).isEqualTo(1)
+        val ctx = ActionContext(Fx.tenantA, ActionActor(owner), workspaceId = w1, projectId = Fx.appA)
+        assertThat(r.engine.status(ctx, run.runId)).isInstanceOf(WorkflowResult.Ok::class.java)
+    }
+
+    @Test fun `B permissions revoked between the schedule and the fire - nothing runs, and a revoked ACTION right stops the step before its effect`() {
+        val r = Rig(); r.grant(*r.all)
+        r.policy.grants[owner]!!.third.remove(LogicPermissions.WORKFLOW_EXECUTE)
+        val refused = r.engine.enqueue(r.fire())
+        assertThat(refused).isEqualTo(EnqueueOutcome.Failed(WorkflowErrorCodes.FORBIDDEN, false))
+        assertThat(r.runCount()).isZero(); assertThat(r.writes()).isZero()
+
+        r.policy.grants[owner]!!.third.add(LogicPermissions.WORKFLOW_EXECUTE)
+        assertThat(r.engine.enqueue(r.fire())).isInstanceOf(EnqueueOutcome.Enqueued::class.java)
+        r.policy.grants[owner]!!.third.remove(LogicPermissions.ACTION_EXECUTE)                   // revoked after the run was queued
+        r.drain()
+        assertThat(r.writes()).isZero()
+        assertThat(r.runs.list(Fx.tenantA, null, 10).single().errorCode).isEqualTo(WorkflowErrorCodes.FORBIDDEN)
+    }
+
+    @Test fun `C a disabled owner - the fire is refused, no run, no effect`() {
+        val r = Rig(); r.grant(*r.all); r.policy.disabled += owner
+        assertThat(r.engine.enqueue(r.fire())).isEqualTo(EnqueueOutcome.Failed(WorkflowErrorCodes.FORBIDDEN, false))
+        assertThat(r.runCount()).isZero(); assertThat(r.writes()).isZero()
+    }
+
+    @Test fun `D another workspace, or none - refused, never a wildcard`() {
+        val r = Rig(); r.grant(*r.all)
+        assertThat(r.engine.enqueue(r.fire(workspace = w2))).isEqualTo(EnqueueOutcome.Failed(WorkflowErrorCodes.FORBIDDEN, false))
+        assertThat(r.engine.enqueue(r.fire(workspace = null))).isEqualTo(EnqueueOutcome.Failed(WorkflowErrorCodes.WORKSPACE_REQUIRED, false))
+        assertThat(r.runCount()).isZero(); assertThat(r.writes()).isZero()
+    }
+
+    @Test fun `E a scheduled run without DATA_MUTATE is denied before the data port`() {
+        val r = Rig(); r.grant(LogicPermissions.APP_USE, LogicPermissions.ACTION_EXECUTE, LogicPermissions.WORKFLOW_EXECUTE)
+        assertThat(r.engine.enqueue(r.fire())).isInstanceOf(EnqueueOutcome.Enqueued::class.java)
+        r.drain()
+        assertThat(r.writes()).isZero()
+        assertThat(r.runs.list(Fx.tenantA, null, 10).single().status).isEqualTo(WorkflowRunStatus.FAILED)
+    }
+}
