# Real-backend E2E (tests/e2e-real). Copy to a file OUTSIDE the repo or export in your shell. Never commit values.
# Docs: docs/C5_REAL_BACKEND_E2E_RUNBOOK.md

# --- required (without them the suite exits 2 = NOT RUN) ---
E2E_STUDIO_URL=http://127.0.0.1:3003
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=

# --- optional ---
# E2E_STUDIO_PREFIX=/studio
# E2E_CHROME=/path/to/chrome
# E2E_HEADED=1
# E2E_OUT_DIR=.run/e2e-real
# E2E_ONLY=E2E-01,E2E-02
# E2E_RUN_ID=

# operator-seeded data project (E2E-07 / E2E-08); user needs APP_EDIT + QUERY_EXECUTE
# E2E_DATA_WORKSPACE_ID=
# E2E_DATA_PROJECT_ID=
# E2E_DATA_QUERY_ID=
# E2E_DATA_USER=
# E2E_DATA_PASSWORD=

# a REACHABLE data source for the "connection test succeeds" checks of E2E-06 (optional; without it that path is NOT exercised, and the failing-test path still runs against a host that cannot exist).
# The target must be a public host with a valid certificate (the platform's own database is refused). Keep E2E_DS_CREDENTIAL_JSON in the shell/secret store, never in a file in the repo.
# E2E_DS_TYPE=postgres
# E2E_DS_CONFIG_JSON={"host":"…","port":5432,"database":"…"}
# E2E_DS_CREDENTIAL_JSON={"username":"…","password":"…"}

# public site origin if different from Studio (E2E-13; E2E-08 reports what <origin>/runtime-config.json answers)
# E2E_PUBLIC_BASE=

# E2E-12 durable workflow (needs a stack with V29 run stores)
# E2E_DURABLE_RUN_STORES=1
# E2E_RESTART_BACKEND_CMD=

# E2E-14 RabbitMQ outage (needs a wired queue adapter)
# E2E_RABBITMQ_WIRED=1
# E2E_STOP_RABBIT_CMD=
# E2E_START_RABBIT_CMD=
